FROM node:lts-alpine AS base

# --- deps ---
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/
RUN npm ci

# --- builder: compile shared -> ui -> web ---
FROM base AS builder
WORKDIR /app
COPY --from=deps /app ./
COPY tsconfig.json ./
COPY packages/shared ./packages/shared
COPY packages/ui ./packages/ui
COPY apps/web ./apps/web
# env file must be present at build time — NEXT_PUBLIC_* vars are inlined
COPY apps/web/.env.prod ./apps/web/.env.prod
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=packages/ui
RUN npm run build --workspace=apps/web

# --- runner ---
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# standalone output (includes traced node_modules + monorepo structure)
COPY --from=builder /app/apps/web/.next/standalone ./
# static assets (not included in standalone trace)
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
# public folder
COPY --from=builder /app/apps/web/public ./apps/web/public
# env file (for runtime config resolution)
COPY apps/web/.env.prod ./apps/web/.env.prod

WORKDIR /app/apps/web
EXPOSE 3000
CMD ["node", "server.js"]

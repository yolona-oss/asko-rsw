# ── Server ──
PORT=4000
SERVER_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
STATIC_PATH=images
ALLOWED_ORIGINS=http://localhost:3000

# ── JWT (ES256 keys, base64-encoded) ──
JWT_ALGORITHM=ES256
ACCESS_JWT_TOKEN_PUBLIC_KEY=base64_encoded_public_key
ACCESS_JWT_TOKEN_PRIVATE_KEY=base64_encoded_private_key
ACCESS_JWT_TOKEN_OPTION_EXPIRES_IN=24h

# ── gRPC Microservice URLs ──
USER_SERVICE_URL=localhost:5000
PAYMENT_SERVICE_URL=localhost:5001
FILE_SERVICE_URL=localhost:5002
REPAIR_SERVICE_URL=localhost:5003
NOTIFICATION_SERVICE_URL=localhost:5004
CHAT_SERVICE_URL=localhost:5005
CONTENT_SERVICE_URL=localhost:5010

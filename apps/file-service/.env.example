# ── Server ──
PORT=4200
GRPC_PORT=5002
METRICS_PORT=9102
SERVER_URL=http://localhost:4000
STATIC_PATH=images

# ── Database (PostgreSQL) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=almagest_root
DATABASE_PASS=your_database_password
DATABASE_DB_NAME=asko_rws_files_db

# ── Redis (BullMQ image resize queue) ──
REDIS_URL=redis://localhost:6379

# ── RabbitMQ ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── File Storage ──
FILE_STORAGE_MODE=cloudinary

# ── Cloudinary ──
CLOUDINARY_RESOLVE_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

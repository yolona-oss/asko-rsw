{
    "name": "@asko/content-gateway",
    "version": "1.0.0",
    "description": "Content gateway for ASKO — articles and user profiles",
    "author": "yolona-oss",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start:dev": "cross-env NODE_ENV=dev nest start --watch",
        "start:debug": "cross-env NODE_ENV=dev nest start --debug --watch",
        "start:prod": "cross-env NODE_ENV=prod node dist/src/main",
        "lint": "eslint src/"
    },
    "dependencies": {
        "@asko/authorization": "workspace:*",
        "@asko/gateway-common": "workspace:*",
        "@asko/observability": "workspace:*",
        "@asko/proto": "workspace:*",
        "@asko/shared": "workspace:*",
        "@grpc/grpc-js": "^1.12.6",
        "@grpc/proto-loader": "^0.7.15",
        "@nestjs/common": "^11.1.5",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.5",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/microservices": "^11.1.5",
        "@nestjs/platform-express": "^11.1.5",
        "@nestjs/swagger": "^11.2.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cross-env": "^7.0.3",
        "dotenv": "^17.2.0",
        "helmet": "^8.1.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.16",
        "@nestjs/testing": "^11.0.16",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.9",
        "@types/express": "^5.0.3",
        "@types/multer": "^1.4.12",
        "@types/node": "^24.1.0",
        "rimraf": "^6.1.3",
        "source-map-support": "^0.5.21",
        "ts-loader": "^9.2.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    }
}

# ── Server ──
PORT=4005
ALLOWED_ORIGINS=http://localhost:3000

# ── gRPC Services ──
USER_SERVICE_ADDR=localhost:5000
FILE_SERVICE_ADDR=localhost:5002
CONTENT_SERVICE_ADDR=localhost:5010

# ── JWT (ES256 keys, base64-encoded, must match other gateways) ──
JWT_ALGORITHM=ES256
JWT_ACCESS_PUBLIC_KEY=base64_encoded_public_key
JWT_ACCESS_PRIVATE_KEY=base64_encoded_private_key
JWT_ACCESS_EXPIRES_IN=24h

# ── Database (PostgreSQL) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=almagest_root
DATABASE_PASS=your_database_password
DATABASE_DB_NAME=asko_rws_payment_db

# ── RabbitMQ ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Payment Providers ──
PAYMENT_DEFAULT_PROVIDER=dummy

# Yookassa (optional)
YOOKASSA_SHOP_ID=

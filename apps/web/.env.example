# ── Frontend ──
# Points to nginx which routes to all gateways
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SITE_URL=https://askoservis.ru
PORT=3000

# ── Analytics (optional) ──
NEXT_PUBLIC_YM_ID=

# ── SEO Verification (optional) ──
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ── Web Push (must match notification-service VAPID_PUBLIC_KEY) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

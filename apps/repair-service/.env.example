# ── Server ──
PORT=4100
GRPC_PORT=5003
METRICS_PORT=9103

# ── Database (PostgreSQL) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=asko_root
DATABASE_PASS=your_database_password
DATABASE_DB_NAME=asko_rws_db

# ── RabbitMQ ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Digital Signature (base64-encoded keys) ──
SIGNATURE_PRIVATE_KEY=base64_encoded_private_key
SIGNATURE_PUBLIC_KEY=base64_encoded_public_key

{
    "name": "notification-service",
    "version": "1.0.0",
    "description": "Notification gRPC + RabbitMQ microservice",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "start:dev": "cross-env NODE_ENV=dev nest start --watch",
        "start:debug": "cross-env NODE_ENV=dev nest start --debug --watch",
        "start:prod": "cross-env NODE_ENV=prod node dist/src/main",
        "lint": "eslint src/",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage"
    },
    "dependencies": {
        "@asko/observability": "workspace:*",
        "@asko/proto": "workspace:*",
        "@asko/shared": "workspace:*",
        "@grpc/grpc-js": "^1.12.6",
        "@grpc/proto-loader": "^0.7.15",
        "@mikro-orm/core": "^6.5.9",
        "@mikro-orm/migrations": "^6.5.9",
        "@mikro-orm/nestjs": "^6.1.1",
        "@mikro-orm/postgresql": "^6.5.9",
        "@nestjs/common": "^11.1.5",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.5",
        "@nestjs/microservices": "^11.1.5",
        "amqp-connection-manager": "^4.1.14",
        "amqplib": "^0.10.4",
        "cross-env": "^7.0.3",
        "ioredis": "^5.8.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "uuid": "^13.0.0"
    },
    "jest": {
        "rootDir": "src",
        "moduleFileExtensions": ["ts", "js", "json"],
        "testRegex": ".*\\.spec\\.ts$",
        "transform": { "^.+\\.ts$": "ts-jest" },
        "moduleNameMapper": {
            "^entities$": "<rootDir>/entities",
            "^entities/(.*)$": "<rootDir>/entities/$1",
            "^common$": "<rootDir>/common",
            "^common/(.*)$": "<rootDir>/common/$1",
            "^modules/(.*)$": "<rootDir>/modules/$1",
            "^services/(.*)$": "<rootDir>/services/$1",
            "^consumers/(.*)$": "<rootDir>/consumers/$1",
            "^controllers/(.*)$": "<rootDir>/controllers/$1"
        },
        "transformIgnorePatterns": ["node_modules/(?!uuid)"]
    },
    "devDependencies": {
        "@mikro-orm/cli": "^6.5.9",
        "@nestjs/cli": "^11.0.16",
        "@nestjs/schematics": "^11.0.5",
        "@nestjs/testing": "^11.0.16",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.1.0",
        "@types/uuid": "^10.0.0",
        "jest": "^30.2.0",
        "rimraf": "^6.1.3",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.2.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    },
    "mikro-orm": {
        "useTsNode": true,
        "configPaths": [
            "./src/mikro-orm.config.ts"
        ]
    }
}

# ── Server ──
PORT=4001
FRONTEND_URL=http://localhost:3000

# ── Cookie ──
COOKIE_SECRET=change_me_in_production

# ── gRPC Services ──
USER_SERVICE_ADDR=localhost:5000

# ── JWT (ES256 keys, base64-encoded, must match other gateways) ──
JWT_ALGORITHM=ES256
JWT_ACCESS_PUBLIC_KEY=base64_encoded_public_key
JWT_ACCESS_PRIVATE_KEY=base64_encoded_private_key
JWT_ACCESS_EXPIRES_IN=24h

# ── OAuth Providers (optional — provider is disabled if not set) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:4001

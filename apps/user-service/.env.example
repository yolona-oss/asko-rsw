# ── gRPC ──
GRPC_PORT=5000
METRICS_PORT=9100

# ── Database (PostgreSQL) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=almagest_root
DATABASE_PASS=your_database_password
DATABASE_DB_NAME=asko_rws_users_db

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT (must match API gateway keys) ──
JWT_ALGORITHM=ES256

ACCESS_JWT_TOKEN_PUBLIC_KEY=base64_encoded_public_key
ACCESS_JWT_TOKEN_PRIVATE_KEY=base64_encoded_private_key
ACCESS_JWT_TOKEN_OPTION_EXPIRES_IN=24h

REFRESH_JWT_TOKEN_PUBLIC_KEY=base64_encoded_public_key
REFRESH_JWT_TOKEN_PRIVATE_KEY=base64_encoded_private_key
REFRESH_JWT_TOKEN_OPTION_EXPIRES_IN=7d

EMAIL_CONFIRMATION_TOKEN_PUBLIC_KEY=base64_encoded_public_key
EMAIL_CONFIRMATION_TOKEN_PRIVATE_KEY=base64_encoded_private_key
EMAIL_CONFIRMATION_TOKEN_EXPIRES_IN=24h
EMAIL_CONFIRMATION_RESEND_IN=5m

RESET_PASSWORD_TOKEN_EXPIRES_IN=10m

# ── Email (SMTP / Nodemailer) ──
EMAIL_HOST=gmail
EMAIL_SMTP_PORT=587
EMAIL_AUTH_USER=your_email@gmail.com
EMAIL_AUTH_PASS=your_app_password
EMAIL_FROM="ASKO <your_email@gmail.com>"

# ── Default Super Admin (created on first startup) ──
DEFAULT_USER_NAME=admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PHONE=79999999999
DEFAULT_USER_PASSWORD=your_secure_password

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# ── OTP Throttle ──
OPT_MAX_ATTEMPTS=3
OPT_DELAY_BETWEEN_ATTEMPTS_SEC=60
OPT_DELAY_BETWEEN_MAX_ATTEMPTS_SEC=360

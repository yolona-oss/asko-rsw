# ── Server ──
GRPC_PORT=5000
METRICS_PORT=9100
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=asko_root
DATABASE_PASS=your_database_password
DATABASE_DB_NAME=asko_rws_users_db

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── RabbitMQ ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── JWT (ES256 keys, base64-encoded, must match API gateway) ──
JWT_ALGORITHM=ES256

JWT_ACCESS_PUBLIC_KEY=base64_encoded_public_key
JWT_ACCESS_PRIVATE_KEY=base64_encoded_private_key
JWT_ACCESS_EXPIRES_IN=24h

JWT_REFRESH_PUBLIC_KEY=base64_encoded_public_key
JWT_REFRESH_PRIVATE_KEY=base64_encoded_private_key
JWT_REFRESH_EXPIRES_IN=7d

JWT_EMAIL_CONFIRM_PUBLIC_KEY=base64_encoded_public_key
JWT_EMAIL_CONFIRM_PRIVATE_KEY=base64_encoded_private_key
JWT_EMAIL_CONFIRM_EXPIRES_IN=24h

JWT_RESET_EXPIRES_IN=10m

# ── Email (SMTP / Nodemailer) ──
EMAIL_HOST=gmail
EMAIL_SMTP_PORT=587
EMAIL_AUTH_USER=your_email@gmail.com
EMAIL_AUTH_PASS=your_app_password
EMAIL_FROM="ASKO <your_email@gmail.com>"

# ── Default Super Admin (created on first startup) ──
SEED_ADMIN_NAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=79999999999
SEED_ADMIN_PASSWORD=your_secure_password

# ── SMS.RU ──
SMS_RU_API_KEY=your_sms_ru_api_key
SMS_RU_TEST_MODE=true

# ── OTP ──
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SEC=60
OTP_LOCKOUT_SEC=360

# ── MFA ──
MFA_TRUSTED_DEVICE_SECRET=random_secret_string


# ── Cross-service event signing ─────────────────────────────
# Generate real keys via: ./scripts/generate-event-signing-keys.sh
# Then replace the placeholder values below. Same keys must be set on
# every service that publishes or consumes events in the listed groups.

EVENT_SIGNING_KEY_PAYMENT=change-me-run-generate-event-signing-keys-sh
EVENT_SIGNING_KEY_DEFAULT=change-me-run-generate-event-signing-keys-sh

EVENT_SIGNING_GROUPS=[{"name":"payment","routingKeys":["payment.*","withdraw.*"],"signing":{"signOnPublish":true,"enforceOnConsume":false,"secretEnv":"EVENT_SIGNING_KEY_PAYMENT"}},{"name":"default","routingKeys":["*"],"signing":{"signOnPublish":false,"enforceOnConsume":false,"secretEnv":"EVENT_SIGNING_KEY_DEFAULT"}}]

# After Phase B rollout (all services deployed with keys), flip
# "enforceOnConsume":true per group to reject unsigned events.

{
    "name": "user-service",
    "version": "1.0.0",
    "description": "User & Auth gRPC microservice",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "start:dev": "cross-env NODE_ENV=dev nest start --watch",
        "start:debug": "cross-env NODE_ENV=dev nest start --debug --watch",
        "start:prod": "cross-env NODE_ENV=prod node dist/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
    },
    "dependencies": {
        "@asko/proto": "workspace:*",
        "@asko/shared": "workspace:*",
        "@grpc/grpc-js": "^1.12.6",
        "@grpc/proto-loader": "^0.7.15",
        "@mikro-orm/cli": "^6.5.9",
        "@mikro-orm/core": "^6.5.9",
        "@mikro-orm/nestjs": "^6.1.1",
        "@mikro-orm/migrations": "^6.5.9",
        "@mikro-orm/postgresql": "^6.5.9",
        "@nestjs/common": "^11.1.5",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.5",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/microservices": "^11.1.5",
        "argon2": "^0.44.0",
        "cross-env": "^7.0.3",
        "ioredis": "^5.8.2",
        "ms": "^2.1.3",
        "nodemailer": "^7.0.5",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "uuid": "^13.0.0"
    },
    "mikro-orm": {
        "useTsNode": true,
        "configPaths": [
            "./src/mikro-orm.config.ts"
        ]
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.16",
        "@nestjs/schematics": "^11.0.5",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.1.0",
        "@types/nodemailer": "^6.4.17",
        "rimraf": "^6.1.3",
        "source-map-support": "^0.5.21",
        "ts-loader": "^9.2.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    }
}

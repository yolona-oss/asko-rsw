FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules

# copy api build
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# copy shared build INTO node_modules scope
COPY --from=builder /app/packages/shared ./node_modules/@asko/shared

# assets
COPY apps/api/images ./apps/api/images
COPY apps/api/.env.prod ./apps/api/.env.prod

WORKDIR /app/apps/api

CMD ["node", "dist/main.js"]

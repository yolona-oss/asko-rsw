{
  "name": "@asko/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:web": "cd packages/shared && npm run build && cd ../../apps/web && npm run build",
    "prod:web": "cd apps/web && npm run start",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5.8"
  },
  "packageManager": "npm@11.10.0",
  "engines": {
    "node": ">=20"
  }
}

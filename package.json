{
  "packageManager": "pnpm@10.33.0",
  "name": "@asko/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "turbo run build --filter=@asko/web",
    "prod:web": "cd apps/web && pnpm run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "turbo": "^2.9.3",
    "typescript": "^5.8",
    "typescript-eslint": "^8.57.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}

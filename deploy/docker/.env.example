# ── Data layer ──────────────────────────────────────────
RABBITMQ_URL=amqp://asko:asko_rmq_pass@localhost:5672
RABBITMQ_DEFAULT_USER=asko
RABBITMQ_DEFAULT_PASS=asko_rmq_pass
REDIS_URL=redis://localhost:6379
REDIS_ADDR=redis://localhost:6379

# ── Cross-service event signing (HMAC) ─────────────────
# EVENT_SIGNING_GROUPS is a JSON array of signing groups. Each group bundles
# a set of routing-key patterns with a signing policy. The matcher picks the
# first group whose patterns match a given routing key; put the catch-all
# ('*') group last. Services that don't set this env treat all events as
# unsigned (soft mode) — matching legacy behavior during rollout.
#
# Per-group fields:
#   name              — identifier used in logs
#   routingKeys       — patterns; trailing '.*' = prefix match, '*' = any
#   signing.signOnPublish     — publishers wrap into SignedEvent envelope
#   signing.enforceOnConsume  — reject unsigned incoming messages
#   signing.secretEnv         — env var holding the current HMAC key
#   signing.previousSecretEnv — optional, for zero-downtime rotation
#   maxSkewMs         — optional replay window (default 300000 = 5 min)
#
# Rotate a key by setting previousSecretEnv=<old>, secretEnv=<new> on every
# service, rolling, then unsetting previous after maxSkewMs×2 has elapsed.
#
EVENT_SIGNING_GROUPS=[{"name":"payment","routingKeys":["payment.*","withdraw.*"],"signing":{"signOnPublish":true,"enforceOnConsume":false,"secretEnv":"EVENT_SIGNING_KEY_PAYMENT"}},{"name":"default","routingKeys":["*"],"signing":{"signOnPublish":false,"enforceOnConsume":false,"secretEnv":"EVENT_SIGNING_KEY_DEFAULT"}}]
EVENT_SIGNING_KEY_PAYMENT=change-me-to-a-strong-random-secret
EVENT_SIGNING_KEY_DEFAULT=change-me-to-a-strong-random-secret

# ── Database (used by each service's own .env.prod) ────
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=asko_root
# DATABASE_PASS=your_database_password

# ── Service gRPC addresses (change host for multi-server) ─
USER_SERVICE_ADDR=localhost:5000
PAYMENT_SERVICE_ADDR=localhost:5001
FILE_SERVICE_ADDR=localhost:5002
REPAIR_SERVICE_ADDR=localhost:5003
NOTIFICATION_SERVICE_ADDR=localhost:5004
CHAT_SERVICE_ADDR=localhost:5005
CONTENT_SERVICE_ADDR=localhost:5010

# ── Service gRPC ports (rarely need to change) ─────────
# USER_SERVICE_GRPC_PORT=5000
# PAYMENT_SERVICE_GRPC_PORT=5001
# FILE_SERVICE_GRPC_PORT=5002
# REPAIR_SERVICE_GRPC_PORT=5003
# NOTIFICATION_SERVICE_GRPC_PORT=5004
# CHAT_SERVICE_GRPC_PORT=5005
# CONTENT_SERVICE_GRPC_PORT=5010

# ── Gateway ports ──────────────────────────────────────
AUTH_GATEWAY_PORT=4001
REPAIR_GATEWAY_PORT=4002
MEDIA_GATEWAY_PORT=4003
REALTIME_GATEWAY_PORT=4004
CONTENT_GATEWAY_PORT=4005

# ── OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost

# ── Frontend ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost
WEB_PORT=3000

# ── Monitoring ─────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_HTTP_PORT=3001
GF_SERVER_ROOT_URL=https://askoservis.ru/grafana/

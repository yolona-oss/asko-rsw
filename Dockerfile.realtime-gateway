# syntax=docker/dockerfile:1
FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS prune
COPY . .
RUN pnpm dlx turbo prune @asko/realtime-gateway --docker

FROM base AS deps
COPY --from=prune /app/out/full/ .
COPY --from=prune /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=prune /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY .npmrc .npmrc
COPY tsconfig.json tsconfig.json
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm config set store-dir /root/.local/share/pnpm/store && \
    pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app ./
RUN pnpm turbo run build --filter=@asko/realtime-gateway...

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/realtime-gateway/dist ./apps/realtime-gateway/dist
COPY --from=builder /app/packages/shared ./node_modules/@asko/shared
# @nestjs/swagger CLI plugin emits `require('.../packages/shared/dist/<enum>')` and
# `require('.../packages/gateway-common/dist/.../auth.response.dto')` using
# source-relative paths, so BOTH packages must also exist at their workspace
# locations in the runner. Gateway-common's dist is ESM; loading it via Node 20's
# require(esm) triggers an ESM resolution of `@asko/shared`, which walks through
# `packages/gateway-common/node_modules/@asko/shared` (a pnpm symlink) and needs
# the full shared package (package.json + dist) at `/app/packages/shared`.
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/packages/gateway-common ./node_modules/@asko/gateway-common
COPY --from=builder /app/packages/gateway-common ./packages/gateway-common
COPY --from=builder /app/packages/observability ./node_modules/@asko/observability
COPY --from=builder /app/packages/proto ./packages/proto
WORKDIR /app/apps/realtime-gateway
CMD ["node", "dist/main.js"]

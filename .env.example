# ─── Root .env.example ────────────────────────────────────────────────
# Each service has its own .env.example in apps/<service>/.env.example
# This file is a quick reference for shared variables.
#
# For per-service configuration, see:
#   apps/api/.env.example
#   apps/user-service/.env.example
#   apps/payment-service/.env.example
#   apps/file-service/.env.example
#   apps/repair-service/.env.example
#   apps/notification-service/.env.example
#   apps/chat-service/.env.example
#   apps/content-service/.env.example
#   apps/web/.env.example

# ── Shared Infrastructure ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=asko_root
DATABASE_PASS=your_database_password

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Web ──
NEXT_PUBLIC_API_URL=http://askoservis:4000
NEXT_PUBLIC_SITE_URL=https://askoservis.ru

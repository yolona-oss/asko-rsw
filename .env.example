# ─── Root .env.example ────────────────────────────────────────────────
# Each app has its own .env.example with service-specific variables.
# This file is a quick reference for shared infrastructure variables.
#
# Per-app configuration:
#   apps/auth-gateway/.env.example
#   apps/repair-gateway/.env.example
#   apps/media-gateway/.env.example
#   apps/realtime-gateway/.env.example
#   apps/content-gateway/.env.example
#   apps/user-service/.env.example
#   apps/payment-service/.env.example
#   apps/file-service/.env.example
#   apps/repair-service/.env.example
#   apps/notification-service/.env.example
#   apps/chat-service/.env.example
#   apps/content-service/.env.example
#   apps/web/.env.example
#
# Docker deployment: deploy/docker/.env.example

# ── Shared Infrastructure ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=asko_root
DATABASE_PASS=your_database_password

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Web ──
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SITE_URL=https://askoservis.ru

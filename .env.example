# ─── API (.env.prod in apps/api/) ────────────────────────────────────

# Server
PORT=4000
SERVER_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
FRONTED_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com
STATIC_PATH=./images

# Database (Postgres)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_DB_NAME=asko
DATABASE_USER=
DATABASE_PASS=

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_ALGORITHM=RS256
JWT_ACCESS_SECRET=
ACCESS_JWT_TOKEN_PUBLIC_KEY=
ACCESS_JWT_TOKEN_PRIVATE_KEY=
ACCESS_JWT_TOKEN_OPTION_EXPIRES_IN=900000
REFRESH_JWT_TOKEN_PUBLIC_KEY=
REFRESH_JWT_TOKEN_PRIVATE_KEY=
REFRESH_JWT_TOKEN_OPTION_EXPIRES_IN=7d
EMAIL_CONFIRMATION_TOKEN_PUBLIC_KEY=
EMAIL_CONFIRMATION_TOKEN_PRIVATE_KEY=
EMAIL_CONFIRMATION_TOKEN_EXPIRES_IN=1d
RESET_PASSWORD_TOKEN_EXPIRES_IN=1h

# Cloudinary
CLOUDINARY_RESOLVE_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP)
EMAIL_HOST=
EMAIL_SMTP_PORT=587
EMAIL_AUTH_USER=
EMAIL_AUTH_PASS=
EMAIL_FROM=

# Stripe
STRIPE_SECRET_KEY=

# Default admin user (seeded on first run)
DEFAULT_USER_NAME=
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=
DEFAULT_USER_PHONE=

# ─── Web (.env.prod in apps/web/) ───────────────────────────────────

NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://your-domain.com

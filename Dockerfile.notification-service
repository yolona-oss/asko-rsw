# syntax=docker/dockerfile:1

FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /app

# ---------- prune ----------
FROM base AS prune
COPY . .
RUN pnpm dlx turbo prune @asko/notification-service --docker

# ---------- deps ----------
FROM base AS deps
COPY --from=prune /app/out/json/ .
COPY --from=prune /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=prune /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY .npmrc .npmrc
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm config set store-dir /root/.local/share/pnpm/store && \
    pnpm install --frozen-lockfile

# ---------- builder ----------
FROM deps AS builder
COPY --from=prune /app/out/full/ .
COPY tsconfig.json tsconfig.json
RUN --mount=type=cache,id=turbo,target=/app/.turbo \
    pnpm turbo run build --filter=@asko/notification-service...

# ---------- runner ----------
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/notification-service/dist ./apps/notification-service/dist
COPY --from=builder /app/packages/shared ./node_modules/@asko/shared
COPY --from=builder /app/packages/observability ./node_modules/@asko/observability
COPY --from=builder /app/packages/proto ./packages/proto

WORKDIR /app/apps/notification-service

EXPOSE 5004 9104

CMD ["node", "dist/main.js"]
